  "narrative": {
    "northStar": "The Motorcycle Passport",
    "overview": "Preserve the established 2shocks identity: graphite, paper and registration-plate yellow; Space Grotesk and Inter; and the existing twin-shock logo. The user rejected replacement visual directions. Refine this system through clearer hierarchy, readable metadata, consistent controls and restrained depth.\n\nThe native app helps riders operate: identify the motorcycle, understand its record and act on the next maintenance task. The sibling website persuades through larger typography and screenshots of these same flows. They share an identity, while density and control sizes follow their platform.",
    "keyCharacteristics": [
      "Graphite identity and white surfaces on paper.",
      "Registration yellow as a recognizable motorcycle accent.",
      "Space Grotesk headings and numerals; Inter for reading and controls.",
      "Immediate content and short, interruptible feedback."
    ],
    "rules": [
      {
        "name": "Shared Identity",
        "body": "Preserve the palette, font pairing and twin-shock logo across app and website; adapt layout and size to the platform.",
        "section": "colors"
      },
      {
        "name": "Immediate Feedback",
        "body": "Routine content is visible immediately. Press feedback is short and interruptible; reduced motion removes unnecessary transforms.",
        "section": "components"
      }
    ],
    "dos": [
      "Do preserve the twin-shock logo and the established palette and font pairing.",
      "Do keep source app screenshots, alt text and feature descriptions in sync.",
      "Do use the website typography clamps and responsive layout from current CSS.",
      "Do retain source labels and distinguish official information, rider entries and parts guidance.",
      "Do respect reduced motion and expose selected, disabled, busy and error states."
    ],
    "donts": [
      "Don't introduce a replacement visual direction or logo.",
      "Don't turn registration yellow into the default fill for every action.",
      "Don't stagger routine screen content or delay keyboard feedback.",
      "Don't imply that prepared garage enquiries or booking requests have already been sent."
    ]
  }
